let args = env::parse_args()

if args.len() < 1:
  return io::println("usage: server <port>")

let server = net::listen("0.0.0.0", args[0])?
io::println("Serveur HTTP démarré sur http://localhost:{}", args[0])

while true:
    let client = server.accept()?
    let req = client.recv()?
    
    let body = "<h1>Salut de la part de LiLang !</h1>"
    let response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 37\r\n\r\n"
    
    client.send(response)?
    client.send(body)?
